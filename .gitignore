# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor  
#  Cursor is an AI-powered code editor.`.cursorignore` specifies files/directories to 
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Imaging data (CC-BY-SA 4.0) must never be committed
data/

# Model checkpoints are large and derived
*.pt

# results/ is ignored by default: predictions (*.nii.gz) and checkpoints (*.pt)
# are large and reproducible, so they stay out of the repo.
results/*
# ...but DO track these small text result files:
!results/comparison.csv
!results/nnunet_run_info.json
!results/metrics/
!results/nnunet_config/
!results/unet_seed0/
!results/unet_seed1/
!results/unet_seed2/
# inside the re-included seed folders, ignore everything except run_info/history
results/unet_seed0/*
results/unet_seed1/*
results/unet_seed2/*
!results/unet_seed0/run_info.json
!results/unet_seed0/history.json
!results/unet_seed1/run_info.json
!results/unet_seed1/history.json
!results/unet_seed2/run_info.json
!results/unet_seed2/history.json